<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nalukit</groupId>
    <artifactId>pololei-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>pololei-creditor</artifactId>

  <name>pololei-creditor</name>
  <description>SEPA Creditor Identifier (EPC262-08) for direct debits, for Java and GWT</description>

  <properties>
    <automatic.module.name>io.github.nalukit.pololei.creditor</automatic.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>pololei</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- a stable JPMS name without a module-info.java, which the GWT compiler would have to ignore -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
    <resources>
      <!-- the GWT compiler needs the sources; JVM users ignore them -->
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.java</include>
        </includes>
        <excludes>
          <exclude>**/package-info.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
  </build>
</project>
